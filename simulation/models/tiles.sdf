<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="concrete_floor">
    <static>true</static>
    <link name="link">
      <collision name="collision">
                <pose>0 0 0 0 0 0</pose>
                <geometry>
                    <plane>
                        <normal>0 0 1</normal>
                        <size>100 100</size>
                    </plane>
                </geometry>
            </collision>
                                              
            <visual name="FLOOR_visual">
                <geometry>
                    <mesh>
                        <scale>0.6 0.6 0.6</scale>
                        <uri>Depot.dae</uri>
                        <submesh>
                            <name>FLOOR</name>
                            <center>false</center>
                        </submesh>
                    </mesh>
                </geometry>
                <material>
                    <diffuse>1.0 1.0 1.0</diffuse>
                    <specular>1.0 1.0 1.0</specular>
                    <pbr>
                        <metal>
                            <albedo_map>textures/Tape_Black_Yellow.png</albedo_map>
                            <normal_map>textures/FLOOR_Normal.png</normal_map>
                            <metalness_map>textures/FLOOR_Metalness.png</metalness_map>
                            <roughness_map>textures/FLOOR_Roughness.png</roughness_map>
                            <light_map uv_set="1">textures/DepotLightmap.png</light_map>
                        </metal>
                    </pbr>
                    
                </material>
            </visual>
    </link>
  </model>
</sdf>